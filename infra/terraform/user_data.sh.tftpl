#!/bin/bash
# PlacementHub first-boot script (EC2 user_data). Runs once, as root.
# Rendered by Terraform: ${"$"}{...} placeholders are filled in by templatefile().
# Shell variables below are written as $NAME (no braces) so Terraform ignores them.
# Log file on the server: /var/log/placementhub-setup.log
set -euxo pipefail
exec > >(tee -a /var/log/placementhub-setup.log) 2>&1

APP_DIR=/opt/placementhub

# ---------------------------------------------------------------- 1. swap
# t3.micro has 1 GB RAM; 2 GB of swap stops Elasticsearch from being killed.
if [ ! -f /swapfile ]; then
  dd if=/dev/zero of=/swapfile bs=1M count=2048
  chmod 600 /swapfile
  mkswap /swapfile
  swapon /swapfile
  echo '/swapfile none swap sw 0 0' >> /etc/fstab
fi

# ---------------------------------------------------------------- 2. kernel setting
# Elasticsearch refuses to start without this (memory-mapped files limit).
sysctl -w vm.max_map_count=262144
echo 'vm.max_map_count=262144' > /etc/sysctl.d/99-elasticsearch.conf

# ---------------------------------------------------------------- 3. Docker + Compose
dnf install -y docker git cronie
systemctl enable --now docker crond
usermod -aG docker ec2-user
mkdir -p /usr/local/lib/docker/cli-plugins
curl -fsSL https://github.com/docker/compose/releases/download/v2.32.4/docker-compose-linux-x86_64 \
  -o /usr/local/lib/docker/cli-plugins/docker-compose
chmod +x /usr/local/lib/docker/cli-plugins/docker-compose

# ---------------------------------------------------------------- 4. code
if [ ! -d "$APP_DIR/.git" ]; then
  git clone --branch "${repo_branch}" "${repo_url}" "$APP_DIR"
fi

# ---------------------------------------------------------------- 5. .env
# The bot token is read from SSM Parameter Store using the instance's IAM
# role; it is never written into this script.
TOKEN=""
if [ "${has_bot_token}" = "true" ]; then
  TOKEN=$(aws ssm get-parameter --region "${aws_region}" --name "${token_param_name}" \
    --with-decryption --query Parameter.Value --output text)
fi

cat > "$APP_DIR/.env" <<EOF
IMAGE_PREFIX=${image_prefix}
IMAGE_TAG=latest
WEB_PORT=80
ES_HEAP=${es_heap}
ES_MEM_LIMIT=${es_mem_limit}
LOG_LEVEL=INFO
S3_BUCKET=${s3_bucket}
AWS_REGION=${aws_region}
TELEGRAM_BOT_TOKEN=$TOKEN
SOURCE_CHAT_IDS=${source_chat_ids}
FORUM_CHAT_ID=${forum_chat_id}
TOPIC_FULLTIME_ID=${topic_fulltime_id}
TOPIC_INTERNSHIP_ID=${topic_internship_id}
TOPIC_HACKATHON_ID=${topic_hackathon_id}
TOPIC_OTHER_ID=${topic_other_id}
EOF
chmod 600 "$APP_DIR/.env"
chown -R ec2-user:ec2-user "$APP_DIR"

# ---------------------------------------------------------------- 6. start the stack
# Prefer the images CD pushed to GHCR; if they are not available yet
# (first deploy, or private packages), build them on the server instead.
cd "$APP_DIR"
if docker compose pull; then
  docker compose up -d
else
  docker compose up -d --build
fi

# ---------------------------------------------------------------- 7. nightly backup
# 21:00 UTC = 02:30 IST. Uses the instance role to write to S3 (no keys).
cat > /etc/cron.d/placementhub-backup <<EOF
0 21 * * * ec2-user cd $APP_DIR && python3 -m scripts.backup_jobs --es-url http://127.0.0.1:9200 --bucket ${s3_bucket} --region ${aws_region} >> /home/ec2-user/backup.log 2>&1
EOF
chmod 644 /etc/cron.d/placementhub-backup

echo "PlacementHub setup finished"
