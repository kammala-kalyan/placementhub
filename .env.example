# Copy this file to .env and adjust values. Never commit .env.
# docker compose reads .env automatically.

# ---- Elasticsearch ----
# JVM heap. 512m locally / on t3.small, 256m on t3.micro.
ES_HEAP=512m
# Hard memory cap for the Elasticsearch container.
ES_MEM_LIMIT=1g

# ---- Web ----
# Host port for the web UI (use 8080 locally if port 80 is busy).
WEB_PORT=80

# ---- API ----
LOG_LEVEL=INFO
# How long search results stay in the Redis cache.
CACHE_TTL_SECONDS=60
# Which parser implementation to use: rules (default) | simple (category only).
PARSER=rules

# ---- Telegram bot ----
# From @BotFather. Keep it secret: anyone with it controls your bot.
TELEGRAM_BOT_TOKEN=
# Placement group(s) to read from, comma-separated (use /whereami in the group).
SOURCE_CHAT_IDS=
# Forum group (Topics enabled) where structured cards are reposted. Optional.
FORUM_CHAT_ID=
# Topic ids inside the forum group (use /whereami inside each topic).
TOPIC_FULLTIME_ID=
TOPIC_INTERNSHIP_ID=
TOPIC_HACKATHON_ID=
TOPIC_OTHER_ID=
# Max bot commands per user per minute.
RATE_LIMIT_PER_MINUTE=10
